# mock = no external call or cost; openai = one real image after approval
EXECUTION_MODE=mock
HOST_PORT=4173
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_AGENT_MODEL=gpt-5-mini
AGENT_PROVIDER=crewai
CREWAI_MODEL=openai/gpt-5-mini
CREWAI_SHARED_SECRET=replace-with-at-least-24-random-characters
CREWAI_REQUEST_TIMEOUT_MS=600000
CREWAI_PORT=8001
IMAGE_ESTIMATED_COST_EUR=0.02

# Optional live email connector
RESEND_API_KEY=
RESEND_FROM=
RESEND_WEBHOOK_SECRET=

# Optional Stripe test-webhook ingestion
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# n8n execution gateway. Use your instance's production webhook base URL.
N8N_WEBHOOK_BASE_URL=
N8N_SHARED_SECRET=replace-with-at-least-24-random-characters
N8N_FULFILLMENT_WEBHOOK=webhook/content-venture-fulfillment
N8N_WELCOME_WEBHOOK=webhook/content-venture-welcome
N8N_OPTIMIZER_WEBHOOK=webhook/content-venture-optimize
N8N_PUBLISH_WEBHOOK=webhook/content-venture-publish

DELIVERY_SIGNING_SECRET=replace-with-at-least-24-random-characters
DELIVERY_LINK_HOURS=168
DELIVERY_MAX_DOWNLOADS=5
PUBLIC_BASE_URL=http://localhost:4173
ALLOW_TEST_ACTIONS=true

# Keep disabled only for localhost. Public deployment must use password mode.
AUTH_MODE=disabled
OWNER_USERNAME=owner
OWNER_PASSWORD=
AUTH_SECRET=
AUTH_SESSION_HOURS=12
AUTH_COOKIE_SECURE=false

# Optional supervised Meta Ads connector. This first slice creates PAUSED drafts only.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_PIXEL_ID=
META_API_VERSION=v25.0
